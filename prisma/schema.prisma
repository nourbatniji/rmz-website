generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}

/// One editable homepage/site section. `draft` is what the editor works on; `published` is what visitors see.
/// Both hold JSON that is validated against the section's Zod schema (src/content/schemas.ts).
model SiteSection {
  key         String    @id
  draft       Json
  published   Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
}

enum ProjectStatus {
  draft
  published
}

/// A work project (archive card + /work/[slug] page). `body` holds the rest of the WorkProject contract.
model Project {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  category  String
  status    ProjectStatus @default(draft)
  order     Int           @default(0)
  body      Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  updatedBy String?
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  pathname  String
  kind      String
  mime      String
  bytes     Int
  width     Int?
  height    Int?
  alt       String?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
