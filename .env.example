# Neon Postgres: use the dev branch connection string for local work
DATABASE_URL=
# Admin sessions: any random string of 32+ characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=
# Private address of the dashboard sign-in page: https://your-site/enter/<this value>. Long random letters/numbers. Without it, /admin shows 404 in production.
ADMIN_ENTRY=
# Vercel Blob read/write token (Vercel dashboard > Storage > Blob). Needed for uploads in the dashboard.
BLOB_READ_WRITE_TOKEN=
